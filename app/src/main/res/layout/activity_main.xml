<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- App Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textColor="#00E5FF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvServiceStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#1E2738"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Continuous Service"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- URL Input Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_dark_card"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Audio Stream URL"
                    android:textColor="#F8FAFC"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etStreamUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1E2738"
                    android:hint="@string/input_url_hint"
                    android:textColorHint="#64748B"
                    android:textColor="#F8FAFC"
                    android:padding="14dp"
                    android:textSize="14sp"
                    android:inputType="textUri"
                    android:maxLines="2" />

                <Button
                    android:id="@+id/btnStreamAudio"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/stream_audio"
                    android:textColor="#00363D"
                    android:backgroundTint="#00E5FF"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Now Playing Display Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_dark_card"
                android:padding="20dp"
                android:gravity="center_horizontal"
                android:layout_marginBottom="20dp">

                <!-- Visual Indicator Status -->
                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#1E2738"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="IDLE"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tvTrackTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Stream Loaded"
                    android:textColor="#F8FAFC"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="2" />

                <TextView
                    android:id="@+id/tvTrackSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paste URL or select a preset to stream"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:gravity="center" />

                <!-- Seekbar -->
                <SeekBar
                    android:id="@+id/seekBarProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:progressTint="#00E5FF"
                    android:thumbTint="#00E5FF" />

                <!-- Playback Times -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvCurrentTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="00:00"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvTotalTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--:--"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Control Buttons Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">

                    <Button
                        android:id="@+id/btnRewind"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="-10s"
                        android:textColor="#F8FAFC"
                        android:backgroundTint="#1E2738"
                        android:layout_marginEnd="12dp" />

                    <Button
                        android:id="@+id/btnPlayPause"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:text="▶"
                        android:textSize="22sp"
                        android:textColor="#00363D"
                        android:backgroundTint="#00E5FF"
                        android:layout_marginEnd="12dp" />

                    <Button
                        android:id="@+id/btnForward"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="+10s"
                        android:textColor="#F8FAFC"
                        android:backgroundTint="#1E2738"
                        android:layout_marginEnd="12dp" />

                    <Button
                        android:id="@+id/btnStop"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="■"
                        android:textColor="#EF4444"
                        android:backgroundTint="#1E2738" />
                </LinearLayout>
            </LinearLayout>

            <!-- Presets Section Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preset_streams"
                android:textColor="#F8FAFC"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Preset container layout -->
            <LinearLayout
                android:id="@+id/llPresetsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
